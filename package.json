{
  "name": "honey-land",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "prepare": "husky install"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-email/components": "0.0.32",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@types/throttle-debounce": "^5.0.2",
    "embla-carousel-autoplay": "^8.5.1",
    "embla-carousel-class-names": "^8.5.1",
    "embla-carousel-react": "^8.5.1",
    "framer-motion": "^11.13.3",
    "gsap": "^3.12.7",
    "next": "14.2.14",
    "next-intl": "^4.14.9",
    "normalize.css": "^8.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.7.0",
    "resend": "^4.1.1",
    "sharp": "^0.33.5",
    "ts-pattern": "^4.3.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^1.22.1",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "antd": "^5.22.4",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "eslint": "^8",
    "eslint-config-next": "14.2.14",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "motion": "^12.0.0",
    "prettier": "3.9.10",
    "react-imask": "^7.6.1",
    "react18-image-magnifier": "^4.0.2",
    "sass": "^1.82.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "throttle-debounce": "^5.0.2",
    "typescript": "^5.7.2",
    "uuid": "^11.0.4",
    "zod": "^3.24.1"
  },
  "lint-staged": {
    "src/**/*.{css,scss}": [
      "stylelint --fix",
      "prettier --write --ignore-unknown"
    ],
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "**/*.{md,json}": "prettier --write"
  }
}
